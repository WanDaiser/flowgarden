---
/**
 * Metin sayfaları (gizlilik, basın kiti): sade ve okunabilir.
 * Canvas yok; hızlı ve yazdırılabilir.
 */
import BaseLayout from './BaseLayout.astro';
import { t, localizePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  kicker?: string;
}
const { locale, title, description, kicker } = Astro.props;
const alt: Locale = locale === 'en' ? 'tr' : 'en';
const altHref = localizePath(Astro.url.pathname, alt);
---

<BaseLayout locale={locale} title={title} description={description}>
  <div class="doc">
    <header class="doc-top container">
      <a class="doc-brand" href={localizePath('/', locale)} aria-label={`WanDaiser Games — ${t(locale, 'nav.home')}`}>
        <img class="pixel" src="/brand/logo_wandaiser_x1.png" width="192" height="56" alt="WanDaiser" />
      </a>
      <a class="pbtn" href={altHref} hreflang={alt} lang={alt} aria-label={t(locale, 'lang.switchLabel')}>{alt.toUpperCase()}</a>
    </header>
    <main id="main" class="container doc-main">
      {kicker && <p class="hud">{kicker}</p>}
      <h1>{title}</h1>
      <slot />
    </main>
    <footer class="container doc-foot hud">
      <a href={localizePath('/', locale)}>← {t(locale, 'nav.home')}</a>
      <span>© {new Date().getFullYear()} <span class="name">WanDaiser Games</span></span>
    </footer>
  </div>
</BaseLayout>

<style>
  .doc {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    background: var(--c-bg);
  }
  .doc-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-6);
  }
  .doc-brand img {
    width: 192px;
    height: 56px;
  }
  .doc-main {
    flex: 1;
    max-width: 760px;
    padding-block: var(--space-8) var(--space-16);
  }
  .doc-main :global(h1) {
    font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
    margin-bottom: var(--space-8);
  }
  .doc-main :global(h2) {
    margin-top: var(--space-12);
  }
  .doc-main :global(p),
  .doc-main :global(li) {
    color: var(--c-text-muted);
  }
  .doc-main :global(strong) {
    color: var(--c-text);
  }
  .doc-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-8);
    border-top: 2px solid var(--c-deep);
  }
  .doc-foot .name {
    text-transform: none;
  }
  .doc-foot a {
    color: var(--c-text-muted);
  }
</style>
